#!/bin/sh
# The one commit-message policy: the commit-msg hook runs it on the message
# git will record, and the CI commits job on each commit and on a pull
# request's title and body, so the two cannot drift. Usage:
# message-policy [option] <file>, or - to read stdin. Exit 0 is clean, 1 is
# refused (one line per broken rule on stderr), 2 is could not judge. The
# options split the rules for the hook, which judges the skip instructions
# on the message with its comment lines kept and the rest on the message
# git's cleanup leaves: --skip-instructions-only and --no-skip-instructions.
#
# Every check is a byte match under the C locale: BSD sed and grep under a
# UTF-8 locale die on a Latin-1 byte, and a dead tool must read as exit 2,
# never as a clean message. The em dash is built by printf, since this file
# must not carry it and dash (Ubuntu's sh) prints $'...' literally.
LC_ALL=C
export LC_ALL

rules=all
case ${1:-} in
    --skip-instructions-only) rules=skip; shift ;;
    --no-skip-instructions) rules=content; shift ;;
esac
case $# in 1) ;; *) echo 'usage: message-policy [--skip-instructions-only | --no-skip-instructions] <file> | -' >&2; exit 2 ;; esac
if [ "$1" = - ]; then
    msg=$(cat) || { echo 'message-policy: stdin could not be read' >&2; exit 2; }
else
    [ -f "$1" ] && [ -r "$1" ] || { printf 'message-policy: %s is not a readable file\n' "$1" >&2; exit 2; }
    msg=$(cat -- "$1") || { printf 'message-policy: %s could not be read\n' "$1" >&2; exit 2; }
fi

fail=0
die() { printf 'message-policy: %s\n' "$1" >&2; exit 2; }
# found <grep args...>: sets hits to the matching lines, numbered, and nums
# to their numbers. It runs in this shell, never in $(...), so a failed tool
# exits 2 instead of printing a wrong line number.
found() {
    hits=$(printf '%s\n' "$msg" | grep -n "$@")
    rc=$?
    [ "$rc" -le 1 ] || die "grep failed (exit $rc)"
    [ "$rc" -eq 0 ] || return 1
    nums=$(printf '%s\n' "$hits" | awk '{ sub(/:.*/, ""); printf "%s%s", (NR > 1 ? " " : ""), $0 }') \
        || die 'awk failed numbering the lines'
    return 0
}

if [ "$rules" != skip ] && found -F -e "$(printf '\342\200\224')"; then
    printf 'message-policy: the em dash character (U+2014) on line %s\n' "$nums" >&2
    fail=1
fi

# git's trailer parser folds case and accepts blanks before the colon.
names='co-authored-by|signed-off-by|co-developed-by|assisted-by|generated-by|reviewed-by|acked-by|tested-by|suggested-by|reported-by'
if [ "$rules" != skip ] && found -i -E -e "^[[:blank:]]*($names)[[:blank:]]*:"; then
    what=$(printf '%s\n' "$hits" | awk '{ sub(/^[0-9]+:[ \t]*/, ""); sub(/[ \t]*:.*/, ""); printf "%s%s", (NR > 1 ? ", " : ""), $0 }') \
        || die 'awk failed naming the trailers'
    printf 'message-policy: an attribution trailer on line %s (%s)\n' "$nums" "$what" >&2
    fail=1
fi

# GitHub skips every workflow of a push whose head commit carries a bracketed
# instruction or a skip-checks trailer, so main would have no ci-ok run for it.
what=
[ "$rules" = content ] || for s in '[skip ci]' '[ci skip]' '[no ci]' '[skip actions]' '[actions skip]'; do
    if found -i -F -e "$s"; then
        what="$what${what:+, }$s on line $nums"
    fi
done
# [[:space:]] takes the carriage return a body from GitHub's web UI ends in.
if [ "$rules" != content ] && found -i -E -e '^[[:blank:]]*skip-checks[[:blank:]]*:[[:blank:]]*true[[:space:]]*$'; then
    what="$what${what:+, }a skip-checks trailer on line $nums"
fi
if [ -n "$what" ]; then
    printf 'message-policy: a workflow skip instruction (%s)\n' "$what" >&2
    fail=1
fi

exit "$fail"
