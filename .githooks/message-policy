#!/bin/sh
# The one commit-message policy: the commit-msg hook runs it on the message
# git will record, and the CI commits job on each commit and on a pull
# request's title and body, so the two cannot drift. Usage:
# message-policy <file>, or message-policy - to read stdin. Exit 0 is clean,
# 1 is refused (one line per broken rule on stderr), 2 is could not judge.
#
# Every check is a byte match under the C locale: BSD sed and grep under a
# UTF-8 locale die on a Latin-1 byte, and a dead tool must read as exit 2,
# never as a clean message. The em dash is built by printf, since this file
# must not carry it and dash (Ubuntu's sh) prints $'...' literally.
LC_ALL=C
export LC_ALL

case $# in 1) ;; *) echo 'usage: message-policy <file> | message-policy -' >&2; exit 2 ;; esac
if [ "$1" = - ]; then
    msg=$(cat) || { echo 'message-policy: stdin could not be read' >&2; exit 2; }
else
    [ -f "$1" ] && [ -r "$1" ] || { printf 'message-policy: %s is not a readable file\n' "$1" >&2; exit 2; }
    msg=$(cat -- "$1") || { printf 'message-policy: %s could not be read\n' "$1" >&2; exit 2; }
fi

fail=0
# found <grep args...>: the matching lines, numbered; 1 is no match and any
# other status is a tool failure, which stops the judgement.
found() {
    hits=$(printf '%s\n' "$msg" | grep -n "$@")
    rc=$?
    [ "$rc" -le 1 ] || { echo "message-policy: grep failed (exit $rc)" >&2; exit 2; }
    return "$rc"
}
lines() {
    printf '%s\n' "$hits" | sed 's/:.*//' | tr '\n' ' ' | sed 's/ $//' || { echo 'message-policy: sed failed' >&2; exit 2; }
}

if found -F -e "$(printf '\342\200\224')"; then
    printf 'message-policy: the em dash character (U+2014) on line %s\n' "$(lines)" >&2
    fail=1
fi

# git's trailer parser folds case and accepts blanks before the colon.
names='co-authored-by|signed-off-by|co-developed-by|assisted-by|generated-by|reviewed-by|acked-by|tested-by|suggested-by|reported-by'
if found -i -E -e "^[[:blank:]]*($names)[[:blank:]]*:"; then
    what=$(printf '%s\n' "$hits" | sed 's/^[0-9]*:[[:blank:]]*//; s/[[:blank:]]*:.*//' | tr '\n' ' ' | sed 's/ $//') \
        || { echo 'message-policy: sed failed' >&2; exit 2; }
    printf 'message-policy: an attribution trailer on line %s (%s)\n' "$(lines)" "$what" >&2
    fail=1
fi

# GitHub skips every workflow of a push whose head commit carries one, so
# main would have no ci-ok run for it.
what=
for s in '[skip ci]' '[ci skip]' '[no ci]' '[skip actions]' '[actions skip]'; do
    if found -i -F -e "$s"; then
        what="$what${what:+, }$s on line $(lines)"
    fi
done
if [ -n "$what" ]; then
    printf 'message-policy: a workflow skip instruction (%s)\n' "$what" >&2
    fail=1
fi

exit "$fail"
