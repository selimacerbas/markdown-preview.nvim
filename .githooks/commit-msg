#!/bin/sh
# Refuses an attribution trailer (a commit names its author alone) and the
# em dash character in the message git records, the two things the CI
# commits job refuses. The character is built by printf, since this file
# must not carry it and POSIX sh has no $'...'.
#
# Git hands this hook the raw message file: git commit -v adds the staged
# diff below its scissors line, and the template's comment lines name the
# branch and the staged files, so either could refuse a clean message
# (measured). So the text is cut at git's own scissors line and its comment
# lines are dropped first, as git's default cleanup after an editor does; a
# comment line a -m message keeps is the CI job's to catch. A failed read
# refuses.
#
# The comment string is git's: core.commentString (git 2.45 on) or
# core.commentChar, else #; auto has no fixed value, so it reads as #.
cc=$(git config core.commentString || git config core.commentChar || echo '#')
case $cc in '' | auto) cc='#' ;; esac
# Escaped, so the scissors pattern reads the comment string literally.
esc=$(printf '%s\n' "$cc" | sed 's/[[\/.^$*]/\\&/g')
raw=$(sed "/^$esc -\{24\} >8 -\{24\}\$/,\$d" "$1") || exit 1
msg=$(printf '%s\n' "$raw" | CC=$cc awk 'index($0, ENVIRON["CC"]) != 1')
dash=$(printf '\342\200\224')
fail=0
if printf '%s\n' "$msg" | grep -qi '^Co-Authored-By:'; then
    echo "commit-msg: attribution trailer refused (CONTRIBUTING.md, Commits)" >&2
    fail=1
fi
if printf '%s\n' "$msg" | grep -qF -e "$dash"; then
    echo "commit-msg: em dash character refused (CONTRIBUTING.md, Commits)" >&2
    fail=1
fi
exit "$fail"
