#!/bin/sh
# Runs .githooks/message-policy, the rules the CI commits job judges,
# on the message git will record. make hooks copies this file into the
# clone's hooks directory; the policy is read from the working tree.
#
# Git hands this hook the raw file, before its own cleanup, so the cleanup
# is reproduced by reading the file, and a file shaped like an editor
# session (git's scissors line, or a line that is the comment string alone)
# is cleaned like one. The CI job judges what git recorded, so a local pass
# is never the last word. commit.cleanup picks the mode as git documents
# it; a --cleanup= on the command line never reaches this hook.
#
# The comment string is the value git reads last of core.commentString and
# core.commentChar, else #. Under auto git picks, when the editor runs, the
# first of # ; @ ! $ % ^ & | : that starts no line of the message, and only
# the final file reaches this hook, so the string is read from git's own
# lines: its scissors line, else the first candidate that is a whole line,
# else no editor ran and git strips # lines, if any.
LC_ALL=C
export LC_ALL

top=$(git rev-parse --show-toplevel) || exit 2
policy=$top/.githooks/message-policy
if [ ! -f "$policy" ]; then
    echo "commit-msg: $policy is missing (a checkout older than it); commit with git commit --no-verify on such a checkout" >&2
    exit 2
fi

cfg=$(git config --get-regexp '^core\.comment(char|string)$')
[ $? -le 1 ] || { echo 'commit-msg: git config failed' >&2; exit 2; }
cc=$(printf '%s\n' "$cfg" | tail -n 1 | sed 's/^[^ ]* //') || exit 2
[ -n "$cc" ] || cc='#'
mode=$(git config --get commit.cleanup)
[ $? -le 1 ] || { echo 'commit-msg: git config failed' >&2; exit 2; }

msg=$(CC=$cc MODE=${mode:-default} awk '
    { line[NR] = $0 }
    function scissors(c) { return c " ------------------------ >8 ------------------------" }
    # git writes two comment lines under its own scissors line; a -m or -F
    # message may carry the scissors text as its own.
    function cut_at(c, i) { return line[i] == scissors(c) && i < NR && index(line[i + 1], c) == 1 }
    END {
        mode = ENVIRON["MODE"]
        cc = ENVIRON["CC"]
        if (mode == "verbatim" || mode == "whitespace") {
            for (i = 1; i <= NR; i++) print line[i]
            exit
        }
        guessed = 0
        if (tolower(cc) == "auto") {
            cc = ""
            n = split("# ; @ ! $ % ^ & | :", cand, " ")
            for (i = 1; i <= NR && cc == ""; i++)
                for (k = 1; k <= n; k++)
                    if (cut_at(cand[k], i)) { cc = cand[k]; break }
            for (k = 1; k <= n && cc == ""; k++)
                for (i = 1; i <= NR; i++)
                    if (line[i] == cand[k]) { cc = cand[k]; break }
            if (cc == "") { cc = "#"; guessed = 1 }
        }
        editor = 0
        end = NR + 1
        if (!guessed)
            for (i = 1; i <= NR; i++) {
                if (line[i] == cc) editor = 1
                if (cut_at(cc, i)) { editor = 1; if (end > NR) end = i }
            }
        drop = mode == "strip" || (mode != "scissors" && editor)
        for (i = 1; i < end; i++)
            if (!drop || index(line[i], cc) != 1) print line[i]
    }' "$1") || { echo 'commit-msg: the message file could not be read' >&2; exit 2; }

exec "$policy" - <<END
$msg
END
